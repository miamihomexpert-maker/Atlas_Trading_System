# Copy to .env and edit. .env is gitignored. Do not put live-trading secrets here.
# ATLAS_LIVE_TRADING must stay false.

ATLAS_INSTRUMENTS=SPY,QQQ
ATLAS_TIMEFRAMES=1h,1d
ATLAS_PAPER_INITIAL_CASH=100000
ATLAS_MAX_MARKET_DATA_AGE_SECONDS=900
ATLAS_DATABASE_PATH=database/atlas.sqlite3
ATLAS_PAPER_APPROVED=true
ATLAS_LOOP_INTERVAL_SECONDS=300
ATLAS_HARD_STOP=false
ATLAS_DASHBOARD_PORT=8765
ATLAS_REQUIRE_REMOTE_APPROVAL=false
ATLAS_LIVE_TRADING=false
# Leave blank to use Yahoo headlines through yfinance. Set a JSON path to override.
ATLAS_NEWS_FILE=
# Fit the daily logistic baseline on the first paper or dashboard run when no model is stored.
ATLAS_AUTO_TRAIN=true
ATLAS_TELEGRAM_BOT_TOKEN=
ATLAS_TELEGRAM_CHAT_ID=
